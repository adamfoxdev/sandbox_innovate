{
  "name": "Secure AI Sandbox",
  "build": {
    "dockerfile": "Dockerfile",
    "context": "..",
    "args": {
      "PYTHON_VERSION": "3.11",
      "CUDA_VERSION": "12.1"
    }
  },

  // Use Docker features
  "features": {
    "ghcr.io/devcontainers/features/git:1": {
      "version": "latest",
      "ppa": true
    },
    "ghcr.io/devcontainers/features/github-cli:1": {
      "version": "latest"
    }
  },

  // VS Code settings
  "customizations": {
    "vscode": {
      "settings": {
        "python.defaultInterpreterPath": "/usr/local/bin/python",
        "python.linting.enabled": true,
        "python.linting.pylintEnabled": false,
        "python.linting.ruffEnabled": true,
        "python.formatting.provider": "none",
        "[python]": {
          "editor.defaultFormatter": "charliermarsh.ruff",
          "editor.formatOnSave": true,
          "editor.codeActionsOnSave": {
            "source.fixAll.ruff": true,
            "source.organizeImports.ruff": true
          }
        },
        "editor.tabSize": 4,
        "editor.insertSpaces": true,
        "files.trimTrailingWhitespace": true,
        "terminal.integrated.defaultProfile.linux": "bash",
        "jupyter.kernels.filter": [
          {
            "path": "/usr/local/bin/python",
            "type": "pythonEnvironment"
          }
        ]
      },
      "extensions": [
        // Python development
        "ms-python.python",
        "ms-python.vscode-pylance",
        "charliermarsh.ruff",

        // Jupyter
        "ms-toolsai.jupyter",
        "ms-toolsai.jupyter-keymap",
        "ms-toolsai.jupyter-renderers",
        "ms-toolsai.vscode-jupyter-cell-tags",

        // GitHub Copilot (requires license)
        "GitHub.copilot",
        "GitHub.copilot-chat",

        // Git
        "GitLens.gitlens",
        "GitHub.vscode-pull-request-github",

        // Docker and containers
        "ms-azuretools.vscode-docker",
        "ms-vscode-remote.remote-containers",

        // YAML / TOML / JSON
        "redhat.vscode-yaml",
        "tamasfe.even-better-toml",

        // Utilities
        "streetsidesoftware.code-spell-checker",
        "eamodio.gitlens",
        "usernamehw.errorlens",

        // Markdown
        "yzhang.markdown-all-in-one",
        "DavidAnson.vscode-markdownlint"
      ]
    }
  },

  // Forward ports
  "forwardPorts": [
    8888,   // JupyterLab
    11434,  // Ollama API
    5000,   // MLflow UI
    8000,   // vLLM / FastAPI
    6006,   // TensorBoard
    3000    // Grafana / Open WebUI
  ],
  "portsAttributes": {
    "8888": {
      "label": "JupyterLab",
      "onAutoForward": "openBrowser"
    },
    "11434": {
      "label": "Ollama API",
      "onAutoForward": "silent"
    },
    "5000": {
      "label": "MLflow UI",
      "onAutoForward": "notify"
    },
    "8000": {
      "label": "API Server",
      "onAutoForward": "silent"
    }
  },

  // Environment variables available inside the container
  "containerEnv": {
    "PYTHONDONTWRITEBYTECODE": "1",
    "PYTHONUNBUFFERED": "1",
    "DO_NOT_TRACK": "1",
    // Pass host environment variables through (set these on your host)
    "HUGGING_FACE_HUB_TOKEN": "${localEnv:HF_TOKEN}",
    "OPENAI_API_KEY": "${localEnv:OPENAI_API_KEY}",
    "ANTHROPIC_API_KEY": "${localEnv:ANTHROPIC_API_KEY}"
  },

  // Mount SSH keys and git config from host
  "mounts": [
    "source=${localEnv:HOME}/.ssh,target=/home/vscode/.ssh,type=bind,consistency=cached,readonly",
    "source=${localEnv:HOME}/.gitconfig,target=/home/vscode/.gitconfig,type=bind,consistency=cached,readonly"
  ],

  // Run after container is created
  "postCreateCommand": "bash .devcontainer/post-create.sh",

  // Run after container starts (every time)
  "postStartCommand": "ollama serve &>/tmp/ollama.log & sleep 3 && echo 'Ollama started' || true",

  // Run as non-root user
  "remoteUser": "vscode",

  // GPU support (uncomment to enable NVIDIA GPU)
  // "hostRequirements": {
  //   "gpu": "optional"
  // },
  // "runArgs": ["--gpus", "all"]
}
